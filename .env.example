PORT=3000
NODE_ENV=development

# Opción A (recomendada para revisar el proyecto): MongoDB local.
# Usa 127.0.0.1 y no localhost (Node 17+ resuelve localhost a IPv6 y falla).
MONGODB_URI=mongodb://127.0.0.1:27017/mundial2018

# Opción B: MongoDB Atlas (reemplaza usuario, password y cluster)
# MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/mundial2018?retryWrites=true&w=majority
